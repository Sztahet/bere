      m_Items: []
  - m_Id: 3311736570293
    m_Localized: BEGINS TO PROTECT THE INDEPENDENT SETTLEMENT HOUSING TRAVEL DOCUMENTATION.
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570294
    m_Localized: BEGINS TO SUPPORT THE SUPPLY EXCHANGE BETWEEN THE VALLEY AND THE NORTH.
