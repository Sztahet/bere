    m_Localized: "Fix Itself (proposal): four outcomes at 25% each \u2014 50 shield, +50% attack speed for 5 s, +50% projectile speed for 5 s, or an unlucky result that stops the tower for 3 s."
    m_Metadata:
      m_Items: []
