    m_Localized: GET READY / GAME MODES
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570201
    m_Localized: SPEEDS UP NEARBY RUNNERS AND MOBS BY 25% FOR 3 SECONDS.
    m_Metadata:
      m_Items: []
