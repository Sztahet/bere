  m_TableData:
  - m_Id: 539082752
    m_Localized: "J\u0118ZYK"
    m_Metadata:
      m_Items: []
  - m_Id: 614580224
    m_Localized: Polski
    m_Metadata:
      m_Items: []
  - m_Id: 614580225
    m_Localized: Angielski
    m_Metadata:
      m_Items: []
  - m_Id: 3311656878080
    m_Localized: "\nCZAS {0:F1} S  \u2022  OBRA\u017BENIA {1:F0}  \u2022  ZDOLNO\u015ACI {2}"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569856
    m_Localized: "\nCzas {0:F1} s  \u2022  obra\u017Cenia {1:F0}  \u2022  zdolno\u015Bci {2}"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569857
    m_Localized: "  \xB7  ZMIE\u0143"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569858
    m_Localized: "  \u2022  {0} AI: {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569859
    m_Localized: "30 BOHATER\xD3W"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569860
    m_Localized: "4 ROLE \xD7 7 \u017BYWIO\u0141\xD3W"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569861
    m_Localized: "4 role \xD7 7 \u017Cywio\u0142\xF3w"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569862
    m_Localized: "ARCHIWUM RIFTORYN  /  \u015AWIAT I BOHATEROWIE"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569863
    m_Localized: "ATAK \xB7 CH\u0141ODNA G\u0141OWA"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569864
    m_Localized: "ATAK \xB7 ELEKTROIMPULS"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569865
    m_Localized: "ATAK \xB7 G\u0118STY MROK"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569866
    m_Localized: "ATAK \xB7 MUR TARCZ"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569867
    m_Localized: "ATAK \xB7 POLE \u017BYCIA"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569868
    m_Localized: "ATAK \xB7 PROMIE\u0143 ZWIADU"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569869
    m_Localized: "ATAK \xB7 SKUPIONY \u017BAR"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569870
    m_Localized: "ATAK \xB7 WSP\xD3LNY IMPULS"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569871
    m_Localized: "ATAK \xB7 ZABURZENIE CELOWANIA"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569872
    m_Localized: "ATAK \xB7 ZAMRO\u017BENIE MECHANIZMU"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569873
    m_Localized: "ATAK \xB7 \u017BAROWA BARIERA"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569874
    m_Localized: "ATAK \xB7 \u017BYWA OSTOJA"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569875
    m_Localized: "AUTO \xB7 "
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569876
    m_Localized: "AUTOMATYCZNY OSTRZA\u0141 WYBRANEJ WIE\u017BY JEST SZYBSZY PRZEZ 5 S."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569877
    m_Localized: "Atak \xB7 Ch\u0142odna g\u0142owa"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569878
    m_Localized: "Atak \xB7 Elektroimpuls"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569879
    m_Localized: "Atak \xB7 G\u0119sty mrok"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569880
    m_Localized: "Atak \xB7 Mur tarcz"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569881
    m_Localized: "Atak \xB7 Pole \u017Cycia"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569882
    m_Localized: "Atak \xB7 Promie\u0144 zwiadu"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569883
    m_Localized: "Atak \xB7 Skupiony \u017Car"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569884
    m_Localized: "Atak \xB7 Wsp\xF3lny impuls"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569885
    m_Localized: "Atak \xB7 Zaburzenie celowania"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569886
    m_Localized: "Atak \xB7 Zamro\u017Cenie mechanizmu"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569887
    m_Localized: "Atak \xB7 \u017Barowa bariera"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569888
    m_Localized: "Atak \xB7 \u017Bywa ostoja"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569889
    m_Localized: "Automatyczny ostrza\u0142 wybranej wie\u017Cy jest szybszy przez 5 s."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569890
    m_Localized: "BADA\u0141A STABILNO\u015A\u0106 SKALNYCH PRZEJ\u015A\u0106 I NAUCZY\u0141A SI\u0118 CZYTA\u0106 TEREN PRZED ROZPOCZ\u0118CIEM PRAC. \u0141\u0104CZY PRECYZJ\u0118 ZWIADU Z WIEDZ\u0104 IN\u017BYNIERSK\u0104."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569891
    m_Localized: "BIA\u0141Y PRZESMYK"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569892
    m_Localized: "BIERZE UDZIA\u0141 DLA SPO\u0141ECZNO\u015ACI SZLAKU, KT\xD3RA CHCE UNIEZALE\u017BNI\u0106 DOSTAWY OD POJEDYNCZEGO DOSTAWCY."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569893
    m_Localized: "BIERZE UDZIA\u0141, ABY WESPRZE\u0106 SIE\u0106 MA\u0141YCH STACJI ZAGRO\u017BONYCH ZAMKNI\u0118CIEM."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569894
    m_Localized: "BIERZE UDZIA\u0141, ABY WIEDZA O SZLAKACH POZOSTA\u0141A DOST\u0118PNA R\xD3WNIE\u017B MNIEJSZYM MIASTOM."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569895
    m_Localized: BOHATER
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569896
    m_Localized: BOHATEROWIE
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569897
    m_Localized: "BOHATEROWIE WYBIERANI S\u0104 ZE WSP\xD3LNEJ PULI BEZ DUPLIKAT\xD3W."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569898
    m_Localized: BRAK
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569899
    m_Localized: BUDOWA
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569900
    m_Localized: "BUDUJ.\nUCIEKAJ.\nADAPTUJ SI\u0118."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569901
    m_Localized: "Bada\u0142a stabilno\u015B\u0107 skalnych przej\u015B\u0107 i nauczy\u0142a si\u0119 czyta\u0107 teren przed rozpocz\u0119ciem prac. \u0141\u0105czy precyzj\u0119 zwiadu z wiedz\u0105 in\u017Cyniersk\u0105."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569902
    m_Localized: "Bia\u0142y Przesmyk"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569903
    m_Localized: "Bierze udzia\u0142 dla spo\u0142eczno\u015Bci szlaku, kt\xF3ra chce uniezale\u017Cni\u0107 dostawy od pojedynczego dostawcy."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569904
    m_Localized: "Bierze udzia\u0142, aby wesprze\u0107 sie\u0107 ma\u0142ych stacji zagro\u017Conych zamkni\u0119ciem."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569905
    m_Localized: "Bierze udzia\u0142, aby wiedza o szlakach pozosta\u0142a dost\u0119pna r\xF3wnie\u017C mniejszym miastom."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569906
    m_Localized: Bohater
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569907
    m_Localized: "Bohaterowie wybierani s\u0105 ze wsp\xF3lnej puli bez duplikat\xF3w."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569908
    m_Localized: "B\u0141YSKAWICE"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569909
    m_Localized: "B\u0141YSKAWICZNY ZWIADOWCA WYSZUKUJ\u0104CY S\u0141ABE PUNKTY OBRONY."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569910
    m_Localized: "B\u0142yskawice"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569911
    m_Localized: "B\u0142yskawiczny zwiadowca wyszukuj\u0105cy s\u0142abe punkty obrony."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569912
    m_Localized: "CEL: DOTRZYJ DO METY   \u2022   CZAS {0:F1} S   \u2022   MG\u0141A {1:F1} S"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569913
    m_Localized: "CEL: DOTRZYJ DO METY   \u2022   CZAS {0:F1} s   \u2022   MG\u0141A {1:F1} s"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569914
    m_Localized: "CHCE UTRZYMA\u0106 DOST\u0118P DO SZLAKU \u0141\u0104CZ\u0104CEGO KILKA ODLEG\u0141YCH OSAD."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569915
    m_Localized: "CHCE ZDOBY\u0106 ZASOBY NA OTWARTY WARSZTAT UCZ\u0104CY BEZPIECZNEJ OBS\u0141UGI WIE\u017B."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569916
    m_Localized: "CH\u0141\xD3D"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569917
    m_Localized: "CH\u0141\xD3D {0:F1}S"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569918
    m_Localized: "CH\u0141\xD3D {0:F1}s"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569919
    m_Localized: "CIEMNO\u015A\u0106"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569920
    m_Localized: CIENISTY PORT
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569921
    m_Localized: "CI\u0118\u017BKIE OBRA\u017BENIA. ROZW\xD3J: QUAKE LUB BOULDER."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569922
    m_Localized: "CZASOWO ZATRZYMUJE OSTRZA\u0141 WIE\u017BY."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569923
    m_Localized: "CZO\u0141O MG\u0141Y PORUSZA SI\u0118 WZD\u0141U\u017B DROGI. JEJ DOTARCIE DO METY SAMO NIE KO\u0143CZY ATAKU."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569924
    m_Localized: "Chce utrzyma\u0107 dost\u0119p do szlaku \u0142\u0105cz\u0105cego kilka odleg\u0142ych osad."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569925
    m_Localized: "Chce zdoby\u0107 zasoby na otwarty warsztat ucz\u0105cy bezpiecznej obs\u0142ugi wie\u017C."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569926
    m_Localized: "Ciemno\u015B\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569927
    m_Localized: Cienisty Port
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569928
    m_Localized: "Ci\u0119\u017Ckie obra\u017Cenia. Rozw\xF3j: Quake lub Boulder."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569929
    m_Localized: "Czasowo zatrzymuje ostrza\u0142 wie\u017Cy."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569930
    m_Localized: "Czo\u0142o mg\u0142y porusza si\u0119 wzd\u0142u\u017C drogi. Jej dotarcie do mety samo nie ko\u0144czy ataku."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569931
    m_Localized: "DALSZY ROZW\xD3J PROWADZI DO WSP\xD3LNEGO ULEPSZENIA T3."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569932
    m_Localized: "DAWNIEJ ZABEZPIECZA\u0141 G\xD3RSKIE KONWOJE I DROGI DO MAGAZYN\xD3W. LODOWA TARCZA JEST ZNAKIEM JEGO SPOSOBU OCHRONY GRUPY."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569933
    m_Localized: "DLACZEGO BIERZE UDZIA\u0141 W PR\xD3BACH"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569934
    m_Localized: 'DO METY: {0} M'
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569935
    m_Localized: "DOCELOWA GRA \u0141\u0104CZY BUDOW\u0118 OBRONY, UCIECZK\u0118 ORAZ ADAPTACJ\u0118 DO RYWALA."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569936
    m_Localized: DODGE
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569937
    m_Localized: "DORASTA\u0141 W\u015AR\xD3D WARSZTAT\xD3W PRZEKA\u0179NIKOWYCH I POMAGA\u0141 OS\u0141ANIA\u0106 EKIPY NAPRAWIAJ\u0104CE PRZEWODNIKI ENERGII."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569938
    m_Localized: "DORASTA\u0141 W\u015AR\xD3D ZA\u0141\xD3G CHRONI\u0104CYCH KONWOJE PRZED ZDRADZENIEM ICH TRASY. SWOJE UMIEJ\u0118TNO\u015ACI MASKOWANIA WYKORZYSTUJE DZI\u015A DO ZAK\u0141\xD3CANIA WYKRYWANIA."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569939
    m_Localized: "DORASTA\u0141A Z SIOSTRAMI W PO\u0141UDNIOWEJ DOLINIE, A P\xD3\u0179NIEJ SZKOLI\u0141A SI\u0118 PRZY BIA\u0141YM PRZESMYKU. LODOWE UMIEJ\u0118TNO\u015ACI WYKORZYSTUJE DO OCHRONY I PRZYWRACANIA SPRAWNO\u015ACI."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569940
    m_Localized: "DOR\u0118CZA\u0141 PILNE WIADOMO\u015ACI MI\u0118DZY STACJAMI PRZEKA\u0179NIKOWYMI. JEGO SZYBKO\u015A\u0106 I WYCZUCIE URZ\u0104DZE\u0143 PRZYDA\u0141Y SI\u0118 P\xD3\u0179NIEJ W LABIRYNTACH."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569941
    m_Localized: "DOSTA\u0143 SI\u0118 DO Z\u0141OTEGO PORTALU, UNIKAJ\u0104C OSTRZA\u0141U I UCIEKAJ\u0104C PRZED MG\u0141\u0104. SPRAWD\u0179, CZY POTRAFISZ ODCZYTA\u0106 ZAGRO\u017BENIA I REAGOWA\u0106 NA CZAS."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569942
    m_Localized: "DOST\u0118PNA W PR\xD3BIE 3D"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569943
    m_Localized: "DOST\u0118PNE  /  PRE-POC"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569944
    m_Localized: "DOST\u0118PNY W PR\xD3BIE"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569945
    m_Localized: "DO\u0141\u0104CZA DO DRU\u017BYN STRZEG\u0104CYCH KONWOJ\xD3W, BO ZNA CEN\u0118 UTRATY BEZPIECZNEJ DROGI."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569946
    m_Localized: DRAFT
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569947
    m_Localized: "DRU\u017BYNA WSP\xD3LNIE ROZWIJA \u017BYWIO\u0141Y I WYBIERA KIERUNKI ULEPSZE\u0143."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569948
    m_Localized: "DRU\u017BYNY BUDUJ\u0104 OBRON\u0118 I PODEJMUJ\u0104 PR\xD3B\u0118 PRZEJ\u015ACIA PRZEZ LABIRYNT PRZECIWNIKA."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569949
    m_Localized: "DRU\u017BYNY INWESTUJ\u0104 I USTAWIAJ\u0104 WIE\u017BE NA SWOICH MAPACH."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569950
    m_Localized: DRZEWKO
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569951
    m_Localized: DRZEWKO TECHNOLOGII
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569952
    m_Localized: "DWIE DRU\u017BYNY"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569953
    m_Localized: "DWIE DRU\u017BYNY PO PI\u0118CIU GRACZY NAPRZEMIENNIE ATAKUJ\u0104 OBRON\u0118 RYWALA."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569954
    m_Localized: "Dalszy rozw\xF3j prowadzi do wsp\xF3lnego ulepszenia T3."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569955
    m_Localized: "Dawniej zabezpiecza\u0142 g\xF3rskie konwoje i drogi do magazyn\xF3w. Lodowa tarcza jest znakiem jego sposobu ochrony grupy."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569956
    m_Localized: 'Do mety: {0} m'
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569957
    m_Localized: "Docelowa gra \u0142\u0105czy budow\u0119 obrony, ucieczk\u0119 oraz adaptacj\u0119 do rywala."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569958
    m_Localized: "Dorasta\u0142 w\u015Br\xF3d warsztat\xF3w przeka\u017Anikowych i pomaga\u0142 os\u0142ania\u0107 ekipy naprawiaj\u0105ce przewodniki energii."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569959
    m_Localized: "Dorasta\u0142 w\u015Br\xF3d za\u0142\xF3g chroni\u0105cych konwoje przed zdradzeniem ich trasy. Swoje umiej\u0119tno\u015Bci maskowania wykorzystuje dzi\u015B do zak\u0142\xF3cania wykrywania."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569960
    m_Localized: "Dorasta\u0142a z siostrami w po\u0142udniowej dolinie, a p\xF3\u017Aniej szkoli\u0142a si\u0119 przy Bia\u0142ym Przesmyku. Lodowe umiej\u0119tno\u015Bci wykorzystuje do ochrony i przywracania sprawno\u015Bci."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569961
    m_Localized: "Dor\u0119cza\u0142 pilne wiadomo\u015Bci mi\u0119dzy stacjami przeka\u017Anikowymi. Jego szybko\u015B\u0107 i wyczucie urz\u0105dze\u0144 przyda\u0142y si\u0119 p\xF3\u017Aniej w labiryntach."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569962
    m_Localized: "Dosta\u0144 si\u0119 do z\u0142otego portalu, unikaj\u0105c ostrza\u0142u i uciekaj\u0105c przed mg\u0142\u0105. Sprawd\u017A, czy potrafisz odczyta\u0107 zagro\u017Cenia i reagowa\u0107 na czas."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569963
    m_Localized: "Do\u0142\u0105cza do dru\u017Cyn strzeg\u0105cych konwoj\xF3w, bo zna cen\u0119 utraty bezpiecznej drogi."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569964
    m_Localized: "Dru\u017Cyna wsp\xF3lnie rozwija \u017Cywio\u0142y i wybiera kierunki ulepsze\u0144."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569965
    m_Localized: "Dru\u017Cyny buduj\u0105 obron\u0119 i podejmuj\u0105 pr\xF3b\u0119 przej\u015Bcia przez labirynt przeciwnika."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569966
    m_Localized: "Dru\u017Cyny inwestuj\u0105 i ustawiaj\u0105 wie\u017Ce na swoich mapach."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569967
    m_Localized: "Dwie dru\u017Cyny po pi\u0119ciu graczy naprzemiennie atakuj\u0105 obron\u0119 rywala."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569968
    m_Localized: "EFEKTY OGRANICZAJ\u0104CE WIDOCZNO\u015A\u0106 TRWAJ\u0104 O 20% KR\xD3CEJ."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569969
    m_Localized: "EFEKTY ZMIENIAJ\u0104 SPOS\xD3B, W JAKI BOHATEROWIE PRZECHODZ\u0104 PRZEZ OBRON\u0118."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569970
    m_Localized: "ENERGICZNA PRZEWODNICZKA, KT\xD3RA SYNCHRONIZUJE RUCH CA\u0141EJ DRU\u017BYNY."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569971
    m_Localized: ERYNDOR
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569972
    m_Localized: "Efekty ograniczaj\u0105ce widoczno\u015B\u0107 trwaj\u0105 o 20% kr\xF3cej."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569973
    m_Localized: "Efekty zmieniaj\u0105 spos\xF3b, w jaki bohaterowie przechodz\u0105 przez obron\u0119."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569974
    m_Localized: "Energiczna przewodniczka, kt\xF3ra synchronizuje ruch ca\u0142ej dru\u017Cyny."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569975
    m_Localized: GOTOWA
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569976
    m_Localized: GOTOWY
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569977
    m_Localized: "GRACZE INWESTUJ\u0104 W DRZEWKA \u017BYWIO\u0141\xD3W NIEZALE\u017BNIE OD \u017BYWIO\u0141U WYBRANEGO BOHATERA."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569978
    m_Localized: GRAJ
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569979
    m_Localized: GRAJ BEZ SOJUSZNIKA
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569980
    m_Localized: "Gracze inwestuj\u0105 w drzewka \u017Cywio\u0142\xF3w niezale\u017Cnie od \u017Cywio\u0142u wybranego bohatera."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569981
    m_Localized: HARTOWANIE
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569982
    m_Localized: HISTORIA
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569983
    m_Localized: HISTORIE
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569984
    m_Localized: "HISTORIE, ROLE I UMIEJ\u0118TNO\u015ACI"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569985
    m_Localized: "HP  {0}     PR\u0118DKO\u015A\u0106  {1}     ODNOWIENIE  {2} S"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569986
    m_Localized: "HP  {0}     PR\u0118DKO\u015A\u0106  {1}     ODNOWIENIE  {2} s"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569987
    m_Localized: "HP  {0}     PR\u0118DKO\u015A\u0106  {1} M/S     Q  {2} S"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569988
    m_Localized: "HP  {0}     PR\u0118DKO\u015A\u0106  {1} m/s     Q  {2} s"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569989
    m_Localized: Hartowanie
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569990
    m_Localized: "Historie, role i umiej\u0119tno\u015Bci"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569991
    m_Localized: IGLICA ZERATH
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569992
    m_Localized: "IMPULS ZESPO\u0141OWY I GOTOWO\u015A\u0106 WIE\u017B"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569993
    m_Localized: "IN\u017BYNIERIA TERENOWA \u2014 KIERUNEK DO ZAPROJEKTOWANIA"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569994
    m_Localized: ISKRA MANEWRU
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569995
    m_Localized: Iglica Zerath
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569996
    m_Localized: "Impuls zespo\u0142owy i gotowo\u015B\u0107 wie\u017C"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569997
    m_Localized: "In\u017Cynieria terenowa \u2014 kierunek do zaprojektowania"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569998
    m_Localized: Iskra manewru
    m_Metadata:
      m_Items: []
  - m_Id: 3311736569999
    m_Localized: "JAKO STRA\u017BNIK WYROBISK CHRONI\u0141 ROBOTNIK\xD3W PODCZAS ZAWALE\u0143 I POMAGA\u0141 UTRZYMA\u0106 PRZEJ\u015ACIA. W LABIRYNCIE WYKORZYSTUJE TARCZ\u0118, BY INNI MOGLI I\u015A\u0106 DALEJ."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570000
    m_Localized: JASNY WZROK
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570001
    m_Localized: "JEGO POCHODZENIE I EWENTUALNE WI\u0118ZI RODZINNE POZOSTAJ\u0104 TAJEMNIC\u0104."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570002
    m_Localized: "JEJ LECZENIE I NAPRAWA S\u0104 O 10% SILNIEJSZE."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570003
    m_Localized: "JELE\u0143 BLASK"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570004
    m_Localized: "JELE\u0143 OS\u0141ANIA SOJUSZNIKA BARIER\u0104; W OBRONIE POMAGA WYKRYWA\u0106 RUNNER\xD3W."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570005
    m_Localized: "Jako stra\u017Cnik wyrobisk chroni\u0142 robotnik\xF3w podczas zawale\u0144 i pomaga\u0142 utrzyma\u0107 przej\u015Bcia. W labiryncie wykorzystuje tarcz\u0119, by inni mogli i\u015B\u0107 dalej."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570006
    m_Localized: Jasny wzrok
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570007
    m_Localized: "Jego pochodzenie i ewentualne wi\u0119zi rodzinne pozostaj\u0105 tajemnic\u0105."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570008
    m_Localized: "Jej leczenie i naprawa s\u0105 o 10% silniejsze."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570009
    m_Localized: "Jele\u0144 os\u0142ania sojusznika barier\u0105; w obronie pomaga wykrywa\u0107 Runner\xF3w."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570010
    m_Localized: "KAEL \xB7 Q: OS\u0141ONA DLA CIEBIE I POBLISKIEGO SOJUSZNIKA. E: TESTOWY ATAK NA POBLISK\u0104 WIE\u017B\u0118."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570011
    m_Localized: "KAEL \xB7 Q: os\u0142ona dla Ciebie i pobliskiego sojusznika. E: testowy atak na poblisk\u0105 wie\u017C\u0119."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570012
    m_Localized: KAMIENNY PANCERZ
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570013
    m_Localized: "KAMIENNY PR\xD3G"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570014
    m_Localized: "KA\u017BDY BOHATER MA W\u0141ASNE POCHODZENIE I POWODY, BY STAN\u0104\u0106 DO PR\xD3B."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570015
    m_Localized: "KA\u017BDY \u017BYWIO\u0141 MA DWA KONKURENCYJNE KIERUNKI ROZWOJU."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570016
    m_Localized: "KLIKNIJ Z\u0141OTE POLE, BY POSTAWI\u0106 LUB USUN\u0104\u0106 WIE\u017B\u0118. OKR\u0118GI POKAZUJ\u0104 ZASI\u0118G."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570017
    m_Localized: KODEKS
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570018
    m_Localized: KONCEPCJA
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570019
    m_Localized: "KONTROLA RUCHU I SPOWOLNIENIA. ROZW\xD3J: GLACIER LUB ICE LANCE."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570020
    m_Localized: "KORZENNA PRZYSTA\u0143"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570021
    m_Localized: KOTOPERZ PATKA
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570022
    m_Localized: "KROK W CIE\u0143"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570023
    m_Localized: "KRUK CIE\u0143"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570024
    m_Localized: "KRUK PRZYJMUJE CZ\u0118\u015A\u0106 OBRA\u017BE\u0143 DZI\u0118KI WI\u0118ZI; W OBRONIE UTRUDNIA ORIENTACJ\u0118."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570025
    m_Localized: "Kamienny Pr\xF3g"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570026
    m_Localized: Kamienny pancerz
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570027
    m_Localized: "Ka\u017Cdy bohater ma w\u0142asne pochodzenie i powody, by stan\u0105\u0107 do Pr\xF3b."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570028
    m_Localized: "Ka\u017Cdy \u017Cywio\u0142 ma dwa konkurencyjne kierunki rozwoju."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570029
    m_Localized: "Kliknij z\u0142ote pole, by postawi\u0107 lub usun\u0105\u0107 wie\u017C\u0119. Okr\u0119gi pokazuj\u0105 zasi\u0119g."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570030
    m_Localized: "Kontrola ruchu i spowolnienia. Rozw\xF3j: Glacier lub Ice Lance."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570031
    m_Localized: "Korzenna Przysta\u0144"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570032
    m_Localized: "Krok w cie\u0144"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570033
    m_Localized: "Kruk przyjmuje cz\u0119\u015B\u0107 obra\u017Ce\u0144 dzi\u0119ki wi\u0119zi; w obronie utrudnia orientacj\u0119."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570034
    m_Localized: "LATA ODBUDOWY ZNISZCZONYCH P\xD3L NAUCZY\u0141Y J\u0104, \u017BE NAJSILNIEJSZY OBRO\u0143CA ZOSTAJE Z TY\u0141U, DOP\xD3KI INNI NIE S\u0104 BEZPIECZNI. \u0141\u0104CZY WYTRZYMA\u0141O\u015A\u0106 Z TROSK\u0104 O DRU\u017BYN\u0118."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570035
    m_Localized: LATARNIA AURELU
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570036
    m_Localized: "LATARNICZKA, KT\xD3RA POMAGA DRU\u017BYNIE DOSTRZEC ZAGRO\u017BENIA."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570037
    m_Localized: "LECZENIE I NAPRAWA OS\u0141ON"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570038
    m_Localized: "LECZY SOJUSZNIK\xD3W I MOBY W POBLI\u017BU PRZEZ 5 S."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570039
    m_Localized: "LINIA W KOLORZE WIE\u017BY OSTRZEGA O PRZYGOTOWYWANYM STRZALE. WIE\u017BE CELUJ\u0104 Z WYPRZEDZENIEM; MURY BLOKUJ\u0104 POCISKI.\n\nOGIE\u0143 \u2014 OBRA\u017BENIA OBSZAROWE I PODPALENIE.\nL\xD3D \u2014 WYCH\u0141ODZENIE I WOLNIEJSZY RUCH.\nB\u0141YSKAWICE \u2014 PRZESKOK NA POBLISKIEGO SOJUSZNIKA.\nNATURA \u2014 TRUCIZNA ZADAJ\u0104CA OBRA\u017BENIA W CZASIE."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570040
    m_Localized: LIS ISKRA
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570041
    m_Localized: "LIS PRZECHWYTUJE POCISK I TWORZY STREF\u0118 \u017BARU; W OBRONIE WSPIERA PRESJ\u0118 OBSZAROW\u0104 WIE\u017BY."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570042
    m_Localized: "LODOWA SABOTA\u017BYSTKA, KT\xD3RA OTWIERA DRU\u017BYNIE BEZPIECZNE PRZEJ\u015ACIE."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570043
    m_Localized: "LODOWY TARCZOWNIK \u2014 KIERUNEK DO ZAPROJEKTOWANIA"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570044
    m_Localized: "Lata odbudowy zniszczonych p\xF3l nauczy\u0142y j\u0105, \u017Ce najsilniejszy obro\u0144ca zostaje z ty\u0142u, dop\xF3ki inni nie s\u0105 bezpieczni. \u0141\u0105czy wytrzyma\u0142o\u015B\u0107 z trosk\u0105 o dru\u017Cyn\u0119."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570045
    m_Localized: Latarnia Aurelu
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570046
    m_Localized: "Latarniczka, kt\xF3ra pomaga dru\u017Cynie dostrzec zagro\u017Cenia."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570047
    m_Localized: "Leczenie i naprawa os\u0142on"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570048
    m_Localized: "Leczy sojusznik\xF3w i moby w pobli\u017Cu przez 5 s."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570049
    m_Localized: "Linia w kolorze wie\u017Cy ostrzega o przygotowywanym strzale. Wie\u017Ce celuj\u0105 z wyprzedzeniem; mury blokuj\u0105 pociski.\n\nOGIE\u0143 \u2014 obra\u017Cenia obszarowe i podpalenie.\nL\xD3D \u2014 wych\u0142odzenie i wolniejszy ruch.\nB\u0141YSKAWICE \u2014 przeskok na pobliskiego sojusznika.\nNATURA \u2014 trucizna zadaj\u0105ca obra\u017Cenia w czasie."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570050
    m_Localized: "Lis przechwytuje pocisk i tworzy stref\u0119 \u017Caru; w obronie wspiera presj\u0119 obszarow\u0105 wie\u017Cy."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570051
    m_Localized: "Lodowa sabota\u017Cystka, kt\xF3ra otwiera dru\u017Cynie bezpieczne przej\u015Bcie."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570052
    m_Localized: "Lodowy tarczownik \u2014 kierunek do zaprojektowania"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570053
    m_Localized: "L\xD3D"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570054
    m_Localized: "L\xF3d"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570055
    m_Localized: "MAPA  \xB7  N \u2191"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570056
    m_Localized: "MECZ DRU\u017BYNOWY"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570057
    m_Localized: "MENU G\u0141\xD3WNE"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570058
    m_Localized: META
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570059
    m_Localized: "META {0}/{1}  \u2022  {2}: {3}"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570060
    m_Localized: "MG\u0141A"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570061
    m_Localized: "MG\u0141A POJAWIA SI\u0118 PO 5 S, SPOWALNIA I Z CZASEM ZADAJE CORAZ WI\u0118KSZE OBRA\u017BENIA. STATUSY WIDA\u0106 NAD PASKIEM HP; KOLOROWE LICZBY OBRA\u017BE\u0143 UNOSZ\u0104 SI\u0118 NAD POSTACI\u0104."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570062
    m_Localized: "MG\u0141A pojawia si\u0119 po 5 s, spowalnia i z czasem zadaje coraz wi\u0119ksze obra\u017Cenia. Statusy wida\u0107 nad paskiem HP; kolorowe liczby obra\u017Ce\u0144 unosz\u0105 si\u0119 nad postaci\u0105."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570063
    m_Localized: "MILCZ\u0104CY STRA\u017BNIK CIENIA, KT\xD3RY ZMIENIA OSTRZA\u0141 W OKAZJ\u0118 DO UNIKU."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570064
    m_Localized: "MILCZ\u0104CY STRA\u017BNIK POJAWI\u0141 SI\u0118 W PORCIE PO WOJNIE. NIKT NIE POTWIERDZI\u0141, CZY ZOSTA\u0141 SKONSTRUOWANY, CZY UKSZTA\u0141TOWANY INACZEJ; SAM SKUPIA SI\u0118 NA OCHRONIE INNYCH."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570065
    m_Localized: "MISTRZ ZAK\u0141\xD3CE\u0143, KT\xD3RY ZACIERA INFORMACJE I DEZORIENTUJE AUTOMATY."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570066
    m_Localized: "MROZOODPORNO\u015A\u0106"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570067
    m_Localized: "Mg\u0142a"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570068
    m_Localized: "Milcz\u0105cy stra\u017Cnik cienia, kt\xF3ry zmienia ostrza\u0142 w okazj\u0119 do uniku."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570069
    m_Localized: "Milcz\u0105cy stra\u017Cnik pojawi\u0142 si\u0119 w porcie po wojnie. Nikt nie potwierdzi\u0142, czy zosta\u0142 skonstruowany, czy ukszta\u0142towany inaczej; sam skupia si\u0119 na ochronie innych."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570070
    m_Localized: "Mistrz zak\u0142\xF3ce\u0144, kt\xF3ry zaciera informacje i dezorientuje automaty."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570071
    m_Localized: "Mrozoodporno\u015B\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570072
    m_Localized: "NA KR\xD3TKO UJAWNIA WIE\u017BE W WYBRANYM FRAGMENCIE TRASY."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570073
    m_Localized: "NA KR\xD3TKO WYKRYWA RUNNER\xD3W I MOBY W WYBRANYM OBSZARZE."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570074
    m_Localized: "NA MINIMAPIE: TY \u2014 Z\u0141OTY, AI \u2014 B\u0141\u0118KITNY, CZERWONY KRZY\u017B \u2014 MIEJSCE \u015AMIERCI. W PANELU DRU\u017BYNY ZOBACZYSZ HP, STATUSY I DYSTANS DO METY."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570075
    m_Localized: "NAJPIERW LICZY SI\u0118 LICZBA RUNNER\xD3W NA MECIE, POTEM CZAS LUB NAJDALSZY POST\u0118P."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570076
    m_Localized: NATURA
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570077
    m_Localized: "NIE USTALONO POKREWIE\u0143STWA Z TRZEMA SIOSTRAMI; JEJ RODZINA POZOSTAJE OTWARTA."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570078
    m_Localized: "NIEZ\u0141OMNY OBRO\u0143CA, KT\xD3RY OS\u0141ANIA DRU\u017BYN\u0118 PRZED OSTRZA\u0141EM."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570079
    m_Localized: "Na kr\xF3tko ujawnia wie\u017Ce w wybranym fragmencie trasy."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570080
    m_Localized: "Na kr\xF3tko wykrywa Runner\xF3w i moby w wybranym obszarze."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570081
    m_Localized: "Na minimapie: TY \u2014 z\u0142oty, AI \u2014 b\u0142\u0119kitny, czerwony krzy\u017C \u2014 miejsce \u015Bmierci. W panelu dru\u017Cyny zobaczysz HP, statusy i dystans do mety."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570082
    m_Localized: "Najpierw liczy si\u0119 liczba Runner\xF3w na mecie, potem czas lub najdalszy post\u0119p."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570083
    m_Localized: Natura
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570084
    m_Localized: "Nie ustalono pokrewie\u0144stwa z trzema siostrami; jej rodzina pozostaje otwarta."
