      m_Items: []
  - m_Id: 3311736570145
    m_Localized: "Odnawia 46 os\u0142ony wie\u017Cy i ogranicza obra\u017Cenia przez 4 s."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570146
    m_Localized: "Odnawia 66 HP i 44 os\u0142ony wybranej \u017Cywej wie\u017Cy."
