      m_Items: []
  - m_Id: 3311736570186
    m_Localized: "PRACOWA\u0141A PRZY KALIBRACJI EMITER\xD3W I NAUCZY\u0141A SI\u0118 ROZPOZNAWA\u0106 S\u0141ABE PUNKTY MECHANIZM\xD3W. W PR\xD3BACH WYKORZYSTUJE T\u0118 WIEDZ\u0118 DO PRECYZYJNEGO SABOTA\u017BU."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570187
    m_Localized: "PRACOWA\u0141A PRZY NAPRAWIE PRZEKA\u0179NIK\xD3W, GDZIE SEKUNDY CZ\u0118STO DECYDOWA\u0141Y, CZY WIADOMO\u015A\u0106 DOTRZE NA CZAS. W PR\xD3BACH UCZY SOJUSZNIK\xD3W DZIA\u0141A\u0106 W JEDNYM RYTMIE."
