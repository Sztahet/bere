      m_Items: []
  - m_Id: 3311736570154
    m_Localized: "Otrzymuje o 10% mniej obra\u017Ce\u0144 od bezpo\u015Brednich trafie\u0144."
    m_Metadata:
      m_Items: []
  - m_Id: 3311736570155
